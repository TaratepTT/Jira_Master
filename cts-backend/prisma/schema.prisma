generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Report {
  id           String   @id @default(uuid())
  name         String
  period       String?
  totalTickets Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tickets      Ticket[]

  @@map("reports")
}

model Ticket {
  id                 String  @id @default(uuid())
  reportId           String  @map("report_id")
  key                String
  system             String
  status             String
  businessUnit       String  @map("business_unit")
  typeOfIssue        String  @map("type_of_issue")
  recurringCategory  String? @map("recurring_category")
  standaloneCategory String? @map("standalone_category")
  summary            String?
  rootCause          String? @map("root_cause")
  resolution         String? @map("resolution")
  deployDate         String? @map("deploy_date")
  assignee           String?  @map("assignee")
  priority           String?  @map("priority")
  ticketCreatedAt    DateTime? @map("ticket_created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([reportId, key])
  @@map("tickets")
}

// Application users (self-registered, approved by an admin).
//   role   : admin | editor | viewer   (viewer = read-only)
//   status : active | pending | disabled
// Stored as plain strings so `prisma db push` never needs an enum migration.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         String    @default("viewer")
  status       String    @default("pending")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("users")
}
