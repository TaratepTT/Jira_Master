generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Report {
  id           String   @id @default(uuid())
  name         String
  period       String?
  totalTickets Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  // Last time "รีเฟรชจาก Jira" pulled live status/assignee/resolved date into this report
  refreshedAt  DateTime? @map("refreshed_at")

  tickets      Ticket[]
  insights     ReportInsight[]

  @@map("reports")
}

model Ticket {
  id                 String  @id @default(uuid())
  reportId           String  @map("report_id")
  key                String
  system             String
  status             String
  businessUnit       String  @map("business_unit")
  typeOfIssue        String  @map("type_of_issue")
  recurringCategory  String? @map("recurring_category")
  standaloneCategory String? @map("standalone_category")
  summary            String?
  rootCause          String? @map("root_cause")
  resolution         String? @map("resolution")
  deployDate         String? @map("deploy_date")
  assignee           String?  @map("assignee")
  priority           String?  @map("priority")
  ticketCreatedAt    DateTime? @map("ticket_created_at")
  // Jira's built-in "resolutiondate" — used for Created vs Resolved and time-to-resolve
  resolvedAt         DateTime? @map("resolved_at")
  // Highest support level reached (L1 / L2 / L3), from the Jira status history
  escalation         String?   @map("escalation")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([reportId, key])
  @@index([key]) // carry-over: find the same ticket in earlier reports
  @@map("tickets")
}

// Application users (self-registered, approved by an admin).
//   role   : admin | editor | viewer   (viewer = read-only)
//   status : active | pending | disabled
// Stored as plain strings so `prisma db push` never needs an enum migration.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         String    @default("viewer")
  status       String    @default("pending")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("users")
}

// AI-generated summaries of a report (currently: recurring root causes).
// The result is stored so viewing it again costs nothing, and token counts are kept
// so you can see what each generation used.
model ReportInsight {
  id            String   @id @default(uuid())
  reportId      String   @map("report_id")
  kind          String   @default("root_cause")
  result        Json
  model         String
  ticketCount   Int      @map("ticket_count")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  createdById   String?  @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, kind, createdAt])
  @@index([createdAt])
  @@map("report_insights")
}

// Who did what. One row per action (a bulk edit writes one row per ticket, grouped by details.batchId).
// No foreign keys on purpose: audit rows must survive deleting a report or a user.
//   action : ticket.update | ticket.bulk_update | ticket.comment | report.create | report.delete | user.update
model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  userName  String   @map("user_name")
  userEmail String   @map("user_email")
  userRole  String   @map("user_role")
  action    String
  reportId  String?  @map("report_id")
  ticketKey String?  @map("ticket_key")
  summary   String
  details   Json?
  success   Boolean  @default(true)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([ticketKey])
  @@map("audit_logs")
}

// A user's own Atlassian account, connected with OAuth 2.0 (3LO).
// When present, that user's Jira reads/writes run as THEM (their name in Jira history,
// their workflow permissions) instead of the shared API token.
// Tokens are stored encrypted (AES-256-GCM, key from JIRA_TOKEN_ENC_KEY).
model JiraConnection {
  userId          String   @id @map("user_id")
  accountId       String   @map("account_id")
  displayName     String   @map("display_name")
  email           String?
  cloudId         String   @map("cloud_id")
  siteUrl         String   @map("site_url")
  accessTokenEnc  String   @map("access_token_enc")
  refreshTokenEnc String   @map("refresh_token_enc")
  expiresAt       DateTime @map("expires_at")
  scopes          String
  // false after a refresh failed (revoked / expired) — the user must connect again
  valid           Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("jira_connections")
}

// A named set of Dashboard filters a user saved ("มุมมองที่บันทึก"), e.g. "Makro ที่ยังเปิด".
// `query` is the dashboard's URL query string (bu=..&st=..), so a view works on any report.
// shared = visible to everyone (only its owner can delete it).
model SavedView {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  userName  String   @map("user_name")
  name      String
  query     String
  shared    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("saved_views")
}

// Small app-wide settings edited by admins, e.g. key "sla" = target days per priority.
model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// คู่มือสำหรับ L1: when a new ticket matches, the steps + Confluence link are posted to the
// ticket as an INTERNAL comment (agents only — customers on the portal never see it).
model Playbook {
  id            String   @id @default(uuid())
  title         String
  confluenceUrl String?  @map("confluence_url")
  steps         String   // what L1 should do, one step per line
  keywords      String   // comma separated, matched against the ticket summary (+ description)
  typeOfIssue   String?  @map("type_of_issue")   // optional extra condition
  system        String?                          // optional extra condition (CMP / VMP / CP TMS)
  enabled       Boolean  @default(true)
  autoSend      Boolean  @default(false) @map("auto_send") // post by itself when a new ticket is created
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("playbooks")
}

// One row per manual written to a ticket (auto or by a person). ticketKey is unique per
// playbook so the same manual is never posted twice to the same ticket.
model PlaybookDelivery {
  id         String   @id @default(uuid())
  playbookId String   @map("playbook_id") // a playbook id, or "confluence:<pageId>" for a Confluence search hit
  ticketKey  String   @map("ticket_key")
  mode       String   // auto | manual
  score      Float
  sentBy     String   @map("sent_by")
  feedback   String?  // helpful | wrong
  feedbackBy String?  @map("feedback_by")
  /// Confluence search deliveries: [{ id, title, url }] of the pages put in the comment
  pages      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([playbookId, ticketKey])
  @@index([ticketKey])
  @@map("playbook_deliveries")
}
